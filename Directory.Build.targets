<Project>
  <PropertyGroup>
    <FiberLockContext>dev</FiberLockContext>
    <FiberLockContext Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</FiberLockContext>
    <FiberLockContext Condition="'$(PublishSingleFile)' == 'true'">$(FiberLockContext)-single</FiberLockContext>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/locks/$(FiberLockContext).lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
