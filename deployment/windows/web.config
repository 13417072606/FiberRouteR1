<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <handlers><clear /><add name="FiberRouteStatic" path="*" verb="GET,HEAD" modules="StaticFileModule" resourceType="File" requireAccess="Read" /></handlers>
    <staticContent>
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".zip" /><mimeMap fileExtension=".zip" mimeType="application/zip" />
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
    <httpProtocol><customHeaders><remove name="X-Content-Type-Options" /><add name="X-Content-Type-Options" value="nosniff" /></customHeaders></httpProtocol>
    <security><requestFiltering><fileExtensions allowUnlisted="false"><clear /><add fileExtension=".json" allowed="true" /><add fileExtension=".zip" allowed="true" /></fileExtensions><hiddenSegments><add segment="private-key.pem" /><add segment="release-payload.json" /><add segment="client-config" /></hiddenSegments></requestFiltering></security>
  </system.webServer>
</configuration>
